# Lab-wide CoreHPC environment. Self-contained on purpose: a copy lives at
# /mnt/fac/<share>/chpc.env and is sourced from ~/.bashrc and job scripts on
# the cluster. In a checkout of this repo, `source env.sh` (any path,
# standalone or submodule) sources this file after project overrides.
#
# Inputs, honoured if already set: FAC_SHARE, CHPC_USER. Everything else
# derives. Safe to source off the cluster: the CHPC_* path variables are
# always exported (handy for composing remote paths from a laptop); the
# cache/conda redirections and the PATH change apply only on cluster nodes.
# shellcheck shell=bash

export FAC_SHARE="${FAC_SHARE:-CX500146_DS1}"                 # our FAC share (verified 2026-09-17)
export CHPC_USER="${CHPC_USER:-${USER:-$(id -un)}}"           # campus username

export CHPC_FAC="/mnt/fac/${FAC_SHARE}"
export CHPC_LAB="${CHPC_FAC}"                                 # persistent shared dir = the share root (see lab/README.md)
export CHPC_GROUP_SCRATCH="/mnt/scratch/group/${FAC_SHARE}"
export CHPC_USER_SCRATCH="/mnt/scratch/user/${CHPC_USER}"

# 1 on a CoreHPC node (login or compute), 0 elsewhere.
if [ -d /mnt/scratch/user ]; then CHPC_ON_CLUSTER=1; else CHPC_ON_CLUSTER=0; fi
export CHPC_ON_CLUSTER

# Containers: prefer the fast scratch mirror, fall back to FAC.
if [ -d "${CHPC_GROUP_SCRATCH}/containers" ]; then
  export CHPC_CONTAINERS="${CHPC_GROUP_SCRATCH}/containers"
else
  export CHPC_CONTAINERS="${CHPC_LAB}/containers"
fi

# Where the tool registry puts things that are not containers. These are the
# directories lab/README.md already describes; naming them means a tool.conf
# never has to spell out an absolute path, so the registry stays portable to a
# different FAC share. Licences are separate from software because they need
# tighter modes (640, group only) and are never copied into an image.
export CHPC_SOFTWARE="${CHPC_LAB}/software"      # native installs (holds moe2024.0601)
# Model weights and databases. Bound READ-WRITE, not read-only: line 52 binds
# /mnt/fac plainly, and it has to stay that way -- RFdiffusion caches its IGSO3
# schedules here, and boltz and chai populate their weight caches here on first
# use. So a job CAN overwrite the lab's shared weights. What protects them is
# the NFSv4 ACL and file modes, not the bind.
export CHPC_REFDATA="${CHPC_LAB}/data"
export CHPC_LICENSES="${CHPC_LAB}/licenses"      # licence files, mode 640

# The tool registry. Unlike the paths above this is an INPUT, not a derived
# value, so it takes the ${:-} form: env.sh sets it to tools/ in the checkout
# you sourced, which is pinned to a commit, and that must win over the copy on
# the share. This fallback is for a shell that sourced the FAC chpc.env alone.
export CHPC_TOOLS="${CHPC_TOOLS:-${CHPC_LAB}/tools}"

# Everything below only makes sense on the cluster; on a laptop it would
# point pip, conda and Hugging Face at directories that do not exist.
if [ "$CHPC_ON_CLUSTER" = 1 ]; then
  # Apptainer: caches off the 20 GiB home; scratch + FAC visible inside containers.
  export APPTAINER_CACHEDIR="${CHPC_USER_SCRATCH}/apptainer/cache"
  export APPTAINER_TMPDIR="${CHPC_USER_SCRATCH}/apptainer/tmp"
  export APPTAINER_BIND="/mnt/scratch,/mnt/fac"

  # Python / ML caches off home.
  export PIP_CACHE_DIR="${CHPC_USER_SCRATCH}/pip"
  export HF_HOME="${CHPC_USER_SCRATCH}/hf"
  export TORCH_HOME="${CHPC_USER_SCRATCH}/torch"
  export XDG_CACHE_HOME="${CHPC_USER_SCRATCH}/cache"

  # Conda (Miniforge3 via CBI). ~/.condarc must also list these dirs; see docs/06.
  export CONDA_ENVS_PATH="${CHPC_USER_SCRATCH}/envs"
  export CONDA_PKGS_DIRS="${CHPC_USER_SCRATCH}/pkgs"

  mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$PIP_CACHE_DIR" "$HF_HOME" "$TORCH_HOME" "$XDG_CACHE_HOME" \
           "$CONDA_ENVS_PATH" "$CONDA_PKGS_DIRS" 2>/dev/null || true

  case ":$PATH:" in *":${CHPC_LAB}/bin:"*) ;; *) export PATH="${CHPC_LAB}/bin:$PATH" ;; esac
fi

# ── Globus ───────────────────────────────────────────────────────────────────
# The approved way data moves between a workstation and the cluster. The AUP
# names three paths -- Globus, the FAC share, Open OnDemand -- and the bastion
# is not one of them (docs/02, docs/10, and the header on scripts/chpc-stage.sh).
#
# These are SITE facts, identical for every lab member, so they belong here and
# not in chpc.env.local. What is per-person is the collection on YOUR machine,
# and that is the only thing you have to declare.
export CHPC_GLOBUS_SCRATCH_COLLECTION="${CHPC_GLOBUS_SCRATCH_COLLECTION:-dd241e70-0935-4f48-b8c0-1351bc1e2c43}"  # "UCSF CoreHPC - User Scratch"
export CHPC_GLOBUS_HOME_COLLECTION="${CHPC_GLOBUS_HOME_COLLECTION:-e6390f3c-59bb-4c9e-b908-938375d88b37}"        # "UCSF CoreHPC - User Home" -- 20 GiB quota, not for data

# What "/" means inside the scratch collection. DERIVED from CHPC_USER, and
# verified on 2026-09-26: `globus ls $CHPC_GLOBUS_SCRATCH_COLLECTION:/` lists
# exactly the contents of $CHPC_USER_SCRATCH. So a collection path is a POSIX
# path with this prefix removed, and the collection is per-user despite being
# one shared UUID -- which is why this derives rather than being declared.
#
# Getting it wrong does not fail: it transfers, successfully, into a directory
# one level from where you meant. Nothing downstream can tell.
export CHPC_GLOBUS_SCRATCH_ROOT="${CHPC_USER_SCRATCH}"

# There is NO FAC collection. That is the whole reason a transfer is two legs:
# Globus reaches user scratch, and a cluster-local copy finishes the trip to
# the persistent share. This is where it buffers -- under the collection by
# construction, and on scratch, which is correct for a buffer precisely because
# it is purged at thirty days: the canonical copy is the one on FAC.
export CHPC_GLOBUS_STAGING="${CHPC_GLOBUS_STAGING:-${CHPC_USER_SCRATCH}/globus-staging}"

# ── Your machine's side of it ────────────────────────────────────────────────
# Per-person, and set in chpc.env.local rather than here. Defaulted to the empty
# string so that sourcing env.sh always yields a COMPLETE environment: a
# consumer that interpolates these -- Hap108or's corehpc profile does -- then
# reads an honest "undeclared" instead of dying on an unset variable a new lab
# member was told they could leave alone.
#
# Empty CHPC_GLOBUS_LOCAL_COLLECTION means "detect it": `globus endpoint
# local-id` asks the Globus Connect Personal process running on this machine, so
# there is nothing to paste and nothing to keep in step with a reinstall. Set it
# only to drive a collection somewhere else.
export CHPC_GLOBUS_LOCAL_COLLECTION="${CHPC_GLOBUS_LOCAL_COLLECTION:-}"
# What "/" means inside it: the home directory for a default Globus Connect
# Personal install, the filesystem root once its config names an absolute path
# outside home -- which is what makes an external volume usable at all.
export CHPC_GLOBUS_LOCAL_ROOT="${CHPC_GLOBUS_LOCAL_ROOT:-/}"
# The directory on this machine that Globus may write. No default, because it
# must be one of the paths ticked writable in Globus Connect Personal's own
# configuration and nothing here can derive that. `chpc-globus.sh doctor`
# resolves it through the root above and lists it through the collection, which
# is the only check that catches a wrong root before a transfer relocates data.
export CHPC_GLOBUS_STAGING_LOCAL="${CHPC_GLOBUS_STAGING_LOCAL:-}"
