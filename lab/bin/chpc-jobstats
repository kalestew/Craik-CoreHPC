#!/usr/bin/env bash
# chpc-jobstats <jobid> [--tasks]
# chpc-jobstats --mine [--days N] [--tasks]
# Read completed jobs' accounting; recommend resources only where the
# accounting describes a single-node batch workload. Never changes jobs.
set -euo pipefail
die() { printf 'chpc-jobstats: %s\n' "$*" >&2; exit 1; }
for arg in "$@"; do
  case "$arg" in
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# //'; exit 0 ;;
  esac
done
JOBID=""; TASKS=0; MINE=0; DAYS=7
while [ $# -gt 0 ]; do
  case "$1" in
    --tasks) TASKS=1 ;;
    --mine) MINE=1 ;;
    --days)
      [ $# -ge 2 ] || die "--days needs a positive integer"
      shift; DAYS="$1" ;;
    --days=*) DAYS="${1#--days=}" ;;
    -*) die "unknown option $1" ;;
    *) [ -z "$JOBID" ] || die "give only one job id"; JOBID="$1" ;;
  esac
  shift
done
case "$DAYS" in ''|*[!0-9]*) die "--days needs a positive integer" ;; esac
[ "$DAYS" -gt 0 ] || die "--days needs a positive integer"
command -v sacct >/dev/null 2>&1 || die "sacct not on PATH -- run this on a login node"
FMT='JobID%64,JobName%64,State%30,Elapsed,TotalCPU,NCPUS,ReqMem,MaxRSS,Partition,QOS,NNodes,NTasks'
if [ "$MINE" = 1 ]; then
  [ -z "$JOBID" ] || die "--mine takes no job id"
  RAW="$(sacct -u "$USER" -S "now-${DAYS}days" --array --format="$FMT" -P --noheader)"
else
  [ -n "$JOBID" ] || die "give a job id, or --mine. See --help."
  RAW="$(sacct -j "$JOBID" --array --format="$FMT" -P --noheader)"
fi
[ -n "$RAW" ] || die "sacct returned no jobs"
HERE="$(cd "$(dirname "$0")" && pwd)"
printf '%s\n' "$RAW" | awk -F'|' -v tasks="$TASKS" -f "$HERE/../lib/jobstats.awk"
