#!/usr/bin/env bash
# $CHPC_LAB/bin/<tool>: a tool's own name as a command. `chpc-tool wrapper
# <tool>` writes one from this file by filling in the two assignments below,
# and `chpc-tool publish` calls that. Everything else -- which image, --nv,
# the binds, the tool's exported variables, the GPU_MAX_CC refusal,
# --writable-tmpfs, the fallback from the scratch mirror to FAC -- is
# chpc-tool's, because this script hands straight over to `chpc-tool exec`:
#
#   foldseek version            is   chpc-tool exec foldseek -- foldseek version
#   boltz predict in.yaml ...   is   chpc-tool exec boltz -- boltz predict in.yaml ...
#
# The one thing a wrapper does differently is that ENTRY is ALWAYS prepended:
# a command named after a tool takes that tool's arguments, whereas
# `chpc-tool exec` prepends ENTRY only before a flag or before nothing at all
# (tools/README.md, Traps). So `boltz bash` is not a shell inside the image;
# `chpc-tool exec boltz -- bash` is.
#
# Until 2026-09-26 this file ran apptainer itself and did none of the above,
# which is why every README says `chpc-tool exec` is the supported form. It
# still is; the wrapper is now merely the same thing under a shorter name.
set -euo pipefail
TOOL=mytool
ENTRY=""

# chpc-tool lives beside this wrapper on the share; a copy elsewhere falls
# back to PATH. The registry (../tools) is resolved by chpc-tool itself.
_here=$(cd "$(dirname "$0")" && pwd -P)
if [ -x "$_here/chpc-tool" ]; then
  _ct="$_here/chpc-tool"
elif _ct=$(command -v chpc-tool 2>/dev/null); then
  :
else
  echo "$(basename "$0"): no chpc-tool beside $_here and none on PATH" >&2
  exit 127
fi
# ENTRY unquoted on purpose: it may be more than one word ("python -u").
# shellcheck disable=SC2086
exec "$_ct" exec "$TOOL" -- ${ENTRY:+$ENTRY} "$@"
