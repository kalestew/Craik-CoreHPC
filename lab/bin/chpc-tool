#!/usr/bin/env bash
# chpc-tool -- resolve and run the lab's software from the tool registry.
#
#   chpc-tool list                          what exists, and whether it is built
#   chpc-tool show <tool>                   one entry, fully resolved
#   chpc-tool show --env [<tool>...]        the same as KEY='value' lines, for a program
#   chpc-tool path <tool>                   the image or install path, for scripts
#   chpc-tool export <tool>...              plain assignments for a project site.conf
#   chpc-tool exec <tool> [--] <cmd>...     run a command through the right runtime
#   chpc-tool doctor [<tool>...]            is it really there, and really working
#   chpc-tool test <tool>...                run the entry's test.sh (what STATUS=verified means)
#
# STATUS: planned -> built -> verified, plus `external` for a tool that is
# deliberately not installed here (a web service). `external` is a terminus,
# not a rung on the way up.
#   chpc-tool build <tool>                  build the container from its .def
#   chpc-tool publish <tool>                copy a built image to the share: sif, .def, wrapper, README row, mirror
#   chpc-tool wrapper <tool>                write $CHPC_LAB/bin/<tool>
#
#   Guide: tools/README.md -- "Run a tool on your inputs", "The CLI", "Add a tool".
#
# The registry is ../../tools relative to this script (or ../tools when this
# script has been copied to $CHPC_LAB/bin). $CHPC_TOOLS overrides it. Resolving
# from the script's own location rather than from PATH is deliberate: a project
# calls this by explicit path out of its pinned submodule, so the definitions it
# gets are the ones its commit says, not whatever the FAC share happens to hold.
#
# Keep this bash-3.2 clean -- no associative arrays, no ${var^^}, no mapfile.
# The lab Macs ship bash 3.2 and the local smoke test has to be able to run it.
set -euo pipefail

die()  { printf 'chpc-tool: %s\n' "$*" >&2; exit 1; }
warn() { printf 'chpc-tool: %s\n' "$*" >&2; }

# --- locate ourselves, through symlinks -------------------------------------
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _d=$(cd "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case $_self in /*) ;; *) _self="$_d/$_self" ;; esac
done
SELF_DIR=$(cd "$(dirname "$_self")" && pwd -P)
# ABSOLUTE from here on. The symlink loop above only rewrites _self when there
# is a symlink to follow, so `corehpc/lab/bin/chpc-tool test boltz` left it
# relative -- and `test` exports it as $CHPC_TOOL and then cd's the test script
# into a scratch directory, where a relative path resolves to nothing. Every
# test.sh that calls "$CHPC_TOOL" exec then died on
#   corehpc/lab/bin/chpc-tool: No such file or directory
# and was reported as the TOOL failing. SELF_DIR was already absolute; _self
# was not, and it is the one that gets exported.
_self="$SELF_DIR/$(basename "$_self")"

# --- the registry ------------------------------------------------------------
# Two layouts: corehpc/lab/bin/chpc-tool -> ../../tools, and a copy published at
# $CHPC_LAB/bin/chpc-tool -> ../tools.
TOOLS=""
for _d in "${CHPC_TOOLS:-}" "$SELF_DIR/../../tools" "$SELF_DIR/../tools"; do
  if [ -n "$_d" ] && [ -d "$_d" ]; then TOOLS=$(cd "$_d" && pwd -P); break; fi
done
[ -n "$TOOLS" ] || die "no tool registry found (looked beside $SELF_DIR; set CHPC_TOOLS)"

# --- the lab environment ------------------------------------------------------
# Same fallback chain as lab/bin/run-in-container. Sourcing our own pinned copy
# before the FAC one keeps a submodule checkout self-consistent off-cluster.
if [ -z "${CHPC_CONTAINERS:-}" ]; then
  for _f in "${CHPC_ENV:-}" "$SELF_DIR/../chpc.env" \
            "/mnt/fac/${FAC_SHARE:-CX500146_DS1}/chpc.env" "$HOME/chpc.env"; do
    if [ -n "$_f" ] && [ -f "$_f" ]; then . "$_f"; break; fi
  done
fi
: "${CHPC_LAB:=/mnt/fac/${FAC_SHARE:-CX500146_DS1}}"
: "${CHPC_CONTAINERS:=$CHPC_LAB/containers}"
: "${CHPC_SOFTWARE:=$CHPC_LAB/software}"
: "${CHPC_REFDATA:=$CHPC_LAB/data}"
: "${CHPC_LICENSES:=$CHPC_LAB/licenses}"
: "${CHPC_ON_CLUSTER:=0}"

# --- loading an entry ---------------------------------------------------------
_FIELDS="NAME VERSION KIND STATUS LICENSE UPSTREAM UPSTREAM_REF IMAGE GPU APPDIR ENTRY PREFIX ENV_YML SUFFIX ENV_NAME MODULE NOTE WRITABLE_TMPFS GPU_MAX_CC GPU_TESTED"

# Helpers a tool.conf may call from tool_exports / tool_doctor.
# Where an image would live, in each of the two places it can live.
# CHPC_CONTAINERS is the fast scratch mirror when one exists, else the FAC copy
# (lab/chpc.env); CHPC_LAB/containers is always the canonical one.
_image_mirror_path() {
  case "${IMAGE:-}" in
    ""|/*) printf '' ;;
    *)     printf '%s/%s' "$CHPC_CONTAINERS" "$IMAGE" ;;
  esac
}
_image_canon_path() {
  case "${IMAGE:-}" in
    ""|/*) printf '' ;;
    *)     printf '%s/containers/%s' "${CHPC_LAB:-}" "$IMAGE" ;;
  esac
}

# Prefer the fast mirror; fall back to the canonical copy PER IMAGE.
#
# lab/chpc.env chooses CHPC_CONTAINERS once, by asking whether the mirror
# DIRECTORY exists. That is right for speed and wrong the moment the mirror is
# incomplete -- and an incomplete mirror is not an edge case, it is scheduled:
# group scratch is purged at 30 days (doc 02), so every image eventually
# vanishes from it while the FAC copy stays put.
#
# MEASURED 2026-09-25: chai1_2.sif and protenix_2.sif were on FAC and absent
# from the mirror, so `chpc-tool exec` refused both with "image not found"
# naming a scratch path -- while the image sat readable on FAC, two directories
# away. `chpc-tool test` therefore could not run either entry, and both were
# stuck at STATUS=built for want of a file that was present.
#
# The mirror is an optimisation. A missing optimisation must degrade to the
# slower correct thing, not fail. Falling back here fixes it for every caller
# at once -- exec, test, doctor and the SIF_* variables tool_exports emits --
# because all four resolve through this one function.
_image_path() {
  case "${IMAGE:-}" in
    "") printf ''; return ;;
    /*) printf '%s' "$IMAGE"; return ;;
  esac
  _ip_fast=$(_image_mirror_path)
  if [ -r "$_ip_fast" ]; then printf '%s' "$_ip_fast"; return; fi
  _ip_canon=$(_image_canon_path)
  if [ -n "${CHPC_LAB:-}" ] && [ "$_ip_canon" != "$_ip_fast" ] && [ -r "$_ip_canon" ]; then
    printf '%s' "$_ip_canon"; return
  fi
  # Neither is readable. Return the preferred path, so a caller's error names
  # the place an operator would stage INTO rather than the fallback.
  printf '%s' "$_ip_fast"
}
_prefix()  { printf '%s' "${PREFIX:-}"; }
_refdata() { printf '%s/%s' "$CHPC_REFDATA" "${1:-${NAME:-}}"; }

# Put this tool's registry variables into the environment, in BOTH forms.
#
# The plain form is what native/conda/module kinds need, and what anything the
# job script shells out to will read. The APPTAINERENV_ form is the only one
# that reaches a container when the image's own %environment sets that name --
# see the note in cmd_export. Doing both is not redundancy: they cover
# different halves of the registry, and which half a given tool needs is not
# knowable from tool.conf.
_export_tool_vars() {
  type tool_exports >/dev/null 2>&1 || return 0
  # Run tool_exports BEFORE globbing is switched off. foldx's finds its binary
  # by glob, because the filename carries an expiry date, and under `set -f`
  # that glob stayed a literal: FOLDX_BINARY came out empty from `exec` and
  # `test` while `chpc-tool export foldx`, which never sets -f, found it.
  # Measured 2026-09-26, as a self-test that said the payload was missing.
  # Then `set -f` for the split below: a VALUE is a path and must not be
  # globbed.
  _lines=$(tool_exports)
  set -f; _ifs=$IFS; IFS='
'
  for _l in $_lines; do
    case "$_l" in
      [A-Za-z_]*=*) eval "export $_l"; eval "export APPTAINERENV_$_l" ;;
    esac
  done
  IFS=$_ifs; set +f
}

_load() {
  _t="$1"
  _conf="$TOOLS/$_t/tool.conf"
  [ -f "$_conf" ] || die "unknown tool '$_t' -- no $_conf. Try: chpc-tool list"
  # Parse before sourcing. A tool.conf is plain shell, so an unquoted value --
  #   UPSTREAM_REF=v3.3.0 (the release tarball)
  # -- is a syntax error, and sourcing it prints a bare
  #   tool.conf: line 8: syntax error near unexpected token `('
  # with no tool name and nothing to say the registry is what is broken. The
  # message matters more than the check: this fails at `export` time, inside
  # an eval, in a job script, where the reader has no reason to suspect a
  # config file. Costs one subshell per load.
  sh -n "$_conf" 2>/dev/null || die "$_t: $_conf is not valid shell.
Values with spaces or shell metacharacters must be quoted:
  UPSTREAM_REF=\"v3.3.0 release tarball\"    not    UPSTREAM_REF=v3.3.0 (release tarball)
$(sh -n "$_conf" 2>&1 | sed 's/^/  /')"
  for _fld in $_FIELDS; do eval "$_fld="; done
  unset -f tool_exports tool_doctor tool_precheck >/dev/null 2>&1 || true
  TOOLDIR="$TOOLS/$_t"
  # shellcheck disable=SC1090
  . "$_conf"
  NAME="${NAME:-$_t}"
  KIND="${KIND:-container}"
  STATUS="${STATUS:-planned}"
  GPU="${GPU:-0}"
}

_all_tools() {
  for _p in "$TOOLS"/*/tool.conf; do
    [ -e "$_p" ] || continue
    _n=$(dirname "$_p"); _n=$(basename "$_n")
    case "$_n" in _*) continue ;; esac     # _template and friends
    printf '%s\n' "$_n"
  done
}

# --- the machine-readable form of an entry ------------------------------------
# `show` prints for a person; `show --env` prints for a program. They are the
# same entry and deliberately not the same text: a consumer that scraped the
# human table would break the day a column widened, and this project's own rule
# for sacct -- parse the structured form, never the printed one -- applies to
# our registry as much as to SLURM's.
#
# WHY THIS EXISTS AT ALL. A tool.conf is sourced shell, so the only faithful
# reader of one is a shell. Anything else -- a Python consumer, a profile loader
# -- either reimplements bash's quoting rules or restates the registry's values
# in a second file, and the second file is the failure the registry README
# warns about: the day an image is rebuilt under a new version, the copy says
# the old name and a job dies on a path that has not existed for a week.
#
# Values are SINGLE-QUOTED with the standard '\'' escape, so the output is
# valid shell AND parseable by shlex in any language, and a value can never be
# confused for a key. One assignment per line; a value carrying a newline is
# refused rather than emitted, because a line-oriented format that can produce
# two lines from one value is not a format.
#
# NOTE is deliberately absent. It is prose for a human reading `show`, it is the
# one field that routinely carries quotes and backticks, and no consumer acts on
# it -- carrying it here would put the registry's most escape-prone field into
# its most escape-sensitive output for nobody's benefit.
_NL='
'
_kv() {
  case "$2" in
    *"$_NL"*) die "${NAME:-?}: $1 contains a newline, which the --env form cannot carry.
The machine-readable form is one assignment per line; keep multi-line prose in NOTE." ;;
  esac
  printf "%s='%s'\n" "$1" "$(printf '%s' "$2" | sed "s/'/'\\\\''/g")"
}

_show_env() {
  for _fld in $_FIELDS; do
    case "$_fld" in NOTE) continue ;; esac
    eval "_v=\${$_fld:-}"
    _kv "$_fld" "$_v"
  done
  _kv TOOLDIR "$TOOLDIR"
  # Resolved, and both candidates beside it. IMAGE_PATH is the answer -- it is
  # what exec, test and the SIF_* exports all use -- and the other two are here
  # so a caller diagnosing "why that copy" does not have to reimplement the
  # choice to find out. Empty for a kind that has no image, rather than absent:
  # a consumer reads a key that is always present and decides on its value.
  case "$KIND" in
    container)
      _kv IMAGE_PATH      "$(_image_path)"
      _kv IMAGE_MIRROR    "$(_image_mirror_path)"
      _kv IMAGE_CANONICAL "$(_image_canon_path)" ;;
    *)
      _kv IMAGE_PATH ""
      _kv IMAGE_MIRROR ""
      _kv IMAGE_CANONICAL "" ;;
  esac
  # The entry's own exports, EVALUATED and re-quoted rather than echoed. What
  # tool_exports emits is source text -- SIF_BOLTZ="/a/b.sif", quotes included --
  # so passing it through would hand a consumer a value with literal quotes
  # around it. Prefixed because these are the TOOL's variable names, chosen to
  # be what the tool itself reads (BOLTZ_CACHE, CHAI_DOWNLOADS_DIR), and one of
  # them could otherwise collide with a registry field name.
  if type tool_exports >/dev/null 2>&1; then
    set -f; _ifs=$IFS; IFS="$_NL"
    for _l in $(tool_exports); do
      case "$_l" in
        [A-Za-z_]*=*)
          _k=${_l%%=*}
          eval "$_l"
          eval "_v=\${$_k:-}"
          _kv "EXPORT_$_k" "$_v" ;;
      esac
    done
    IFS=$_ifs; set +f
  fi
}

# --- subcommands ---------------------------------------------------------------
cmd_list() {
  printf '%-14s %-9s %-10s %-9s %-4s %s\n' NAME VERSION KIND STATUS GPU LICENSE
  for _t in $(_all_tools); do
    ( _load "$_t"
      _g=no; [ "$GPU" = "1" ] && _g=yes
      printf '%-14s %-9s %-10s %-9s %-4s %s\n' \
        "$NAME" "${VERSION:--}" "$KIND" "$STATUS" "$_g" "${LICENSE:--}" )
  done
}

cmd_show() {
  _env=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --env) _env=1; shift ;;
      --)    shift; break ;;
      -*)    die "chpc-tool show: unknown option '$1'" ;;
      *)     break ;;
    esac
  done

  if [ "$_env" = 0 ]; then
    [ $# -ge 1 ] || die "usage: chpc-tool show <tool>   (or: chpc-tool show --env [<tool>...])"
    _load "$1"
    printf 'name        %s\n' "$NAME"
    printf 'version     %s\n' "${VERSION:--}"
    printf 'kind        %s\n' "$KIND"
    printf 'status      %s\n' "$STATUS"
    printf 'licence     %s\n' "${LICENSE:--}"
    printf 'upstream    %s\n' "${UPSTREAM:--}"
    printf 'upstream#   %s\n' "${UPSTREAM_REF:-not recorded}"
    printf 'entry dir   %s\n' "$TOOLDIR"
    case "$KIND" in
      container)
        printf 'image       %s\n' "$(_image_path)"
        printf 'gpu (--nv)  %s\n' "$([ "$GPU" = 1 ] && echo yes || echo no)"
        [ -n "${GPU_MAX_CC:-}" ] && printf 'gpu max cc  %s  (ask for --gres=gpu:nvidia_l40s:1 or nvidia_h100_nvl:1, never a bare gpu:1)\n' "$GPU_MAX_CC"
        # A ceiling is not a measurement. GPU_MAX_CC says what will not die of a
        # missing kernel image; this says where anybody has actually run it. A
        # request can satisfy the first and still be the first run on a class.
        if [ -n "${GPU_TESTED:-}" ]; then
          printf 'gpu tested  %s  (classes this entry has passed on; anything else is unevidenced)\n' "$GPU_TESTED"
        elif [ "$GPU" = 1 ]; then
          printf 'gpu tested  (none recorded -- no device class is written down as exercised)\n'
        fi
        [ "${WRITABLE_TMPFS:-0}" = 1 ] && printf 'tmpfs       --writable-tmpfs\n'
        [ -n "${APPDIR:-}" ] && printf 'appdir      %s  (inside the image)\n' "$APPDIR" ;;
      module)
        [ -n "${MODULE:-}" ]  && printf 'module      %s\n' "$MODULE" ;;
      *)
        [ -n "${PREFIX:-}" ]  && printf 'prefix      %s\n' "$PREFIX"
        [ -n "${ENV_YML:-}" ] && printf 'recipe      %s\n' "$ENV_YML" ;;
    esac
    # The default program, and the one rule about it that costs people a run:
    # `exec <tool> predict x` runs a program called predict. Always -- <program>.
    [ -n "${ENTRY:-}" ] && printf 'entry       %s  (used when exec is given no command or a leading flag; otherwise write it after --)\n' "$ENTRY"
    if type tool_exports >/dev/null 2>&1; then
      printf 'exports\n'
      tool_exports | sed 's/^/            /'
    fi
    # The runtime caveats. Printed here and nowhere else: --env omits NOTE on
    # purpose (see _show_env), and a person reading the entry is who it is for.
    if [ -n "${NOTE:-}" ]; then
      printf 'note\n'
      printf '%s\n' "$NOTE" | fold -s -w 72 | sed 's/ *$//; s/^/            /'
    fi
    return 0
  fi

  if [ $# -eq 0 ]; then
    # shellcheck disable=SC2046
    set -- $(_all_tools)
  fi
  _first=1
  for _t in "$@"; do
    [ "$_first" = 1 ] || echo
    _first=0
    ( _load "$_t"; _show_env )
  done
}

cmd_path() {
  [ $# -ge 1 ] || die "usage: chpc-tool path <tool>"
  _load "$1"
  case "$KIND" in
    container) _image_path; printf '\n' ;;
    *)         printf '%s\n' "${PREFIX:-}" ;;
  esac
}

cmd_export() {
  [ $# -ge 1 ] || die "usage: chpc-tool export <tool>..."
  for _t in "$@"; do
    ( _load "$_t"
      # `export NAME=value`, not a bare assignment. Two things need it.
      # Apptainer passes the HOST environment into a container, so a path the
      # registry resolved -- BOLTZ_CACHE, RFDIFFUSION_MODELS -- reaches the
      # software inside only if it was exported; a bare assignment in
      # site.conf stops at the job script, and the tool then falls back to its
      # own default, which for Boltz means trying to download 5 GB of weights
      # from a compute node that has no internet. And a stage script that
      # shells out gets the same value the job script had.
      # This is still an UNCONDITIONAL assignment, so site.conf continues to
      # win over whatever is already in the environment and a stray exported
      # variable cannot redirect a tool path. Only the run-size knobs use the
      # ${NAME:-default} form, and they are not emitted here.
      #
      # APPTAINERENV_ is not belt and braces, it is the only thing that works.
      # Measured on Apptainer 1.5.2 (2026-09-18): a plain host export LOSES to
      # a name the image's own %environment sets, even when the image writes
      # it defensively as ${VAR:-default} -- the default still wins. Only
      # APPTAINERENV_<NAME> or --env overrides it. A host variable the image
      # never mentions does pass through, which is why this was invisible
      # until chai1, whose image sets CHAI_DOWNLOADS_DIR as a /tmp fallback:
      # the registry pointed at FAC, the container used /tmp, and the only
      # symptom was weights quietly landing in the wrong place.
      if type tool_exports >/dev/null 2>&1; then
        tool_exports | sed 's/^\([A-Za-z_][A-Za-z0-9_]*=\)/export \1/'
        tool_exports | sed 's/^\([A-Za-z_][A-Za-z0-9_]*=\)/export APPTAINERENV_\1/'
      fi )
  done
}

cmd_exec() {
  [ $# -ge 1 ] || die "usage: chpc-tool exec <tool> [--] <command>..."
  _load "$1"; shift
  if [ "${1:-}" = "--" ]; then shift; fi
  # ENTRY applies to every kind, not just containers: `chpc-tool exec dssp`
  # should run mkdssp the same way `chpc-tool exec boltz` runs boltz. It is
  # also prepended when the first argument is a FLAG, so that
  # `chpc-tool exec dssp --version` means "mkdssp --version" rather than
  # trying to execute a program called --version. No real command starts with
  # a dash, so this is unambiguous in practice.
  if [ -n "${ENTRY:-}" ]; then
    case "${1:-}" in
      ''|-*) # shellcheck disable=SC2086
             set -- $ENTRY ${1:+"$@"} ;;
    esac
  fi
  [ $# -gt 0 ] || die "$NAME: no command given and no ENTRY in tool.conf"
  # This tool's own variables, exported, for the reason cmd_export gives: the
  # weights and cache paths the registry resolves have to reach the process,
  # and inside a container they only do if they are in the environment.
  # Without this, `chpc-tool exec boltz -- boltz predict ...` would work after
  # sourcing site.conf and silently try to download from a compute node
  # without it.
  _export_tool_vars
  case "$KIND" in
    container)
      _sif=$(_image_path)
      [ -n "$_sif" ] || die "$NAME: KIND=container but IMAGE is empty"
      [ -r "$_sif" ] || die "$NAME: image not found: $_sif (status is $STATUS)"
      _args="exec"
      [ "$GPU" = "1" ] && _args="$_args --nv"
      # chpc.env normally exports APPTAINER_BIND; only bind explicitly if not.
      [ -z "${APPTAINER_BIND:-}" ] && _args="$_args --bind /mnt/scratch,/mnt/fac"
      # WRITABLE_TMPFS=1 for tools that insist on writing inside their own
      # image. rfdiffusion3 is the case: foundry persists the checkpoint
      # directory with dotenv.set_key() into /app/foundry/.env, and dotenv
      # rewrites atomically, so it needs the DIRECTORY writable, not just the
      # file -- a bind over the file does not help. The overlay is in memory
      # and discarded at exit, which is right: the write is ~2.5 KB of config
      # we do not want to keep, and the real payload goes to --checkpoint-dir
      # on the share. Do not reach for this to make a tool write DATA into its
      # image; that belongs on FAC (doc 07).
      [ "${WRITABLE_TMPFS:-0}" = "1" ] && _args="$_args --writable-tmpfs"
      # GPU_MAX_CC: refuse a device the image has no kernels for, BEFORE the
      # job spends minutes loading weights to find out.
      #
      # A CUDA binary carries kernels only for the architectures it was
      # compiled for, and the gpu partition here is three of them (doc 05).
      # Land a cu121 image on a Blackwell node and it dies with
      #   CUDA error: no kernel image is available for execution on the device
      # which reads as a broken installation, is really a scheduling
      # accident, and is intermittent -- the same script passes or fails on
      # what happened to be free. nvidia-smi answers in milliseconds and
      # needs no torch, so the check is close to free.
      #
      # Compares as a decimal: 12.0 > 9.0. Silent when there is no GPU, no
      # nvidia-smi (the login node has none) or no GPU_MAX_CC, so it can
      # never block a tool that did not declare a limit.
      #
      # ASKING nvidia-smi IS NOT FREE OF CONSEQUENCES, twice over, and both
      # bit on a CPU node (measured on ccpu1-01, 2026-09-26):
      #
      #  1. nvidia-smi EXITS 9 when it cannot reach the driver. With
      #     `set -euo pipefail` at the top of this file, the bare assignment
      #     that used to be here made a plain pipeline carry that 9 out, and
      #     `set -e` killed chpc-tool on the spot -- no message, exit 9,
      #     nothing run. `chpc-tool exec rfdiffusion3 -- python ...` on the
      #     `community` partition therefore failed in a way that read as a
      #     broken image, and rfdiffusion3's test.sh says "CPU is fine" and
      #     could not pass on a CPU node. `|| _cc=""` puts the assignment in
      #     a list, where `set -e` leaves it alone.
      #
      #  2. nvidia-smi prints that complaint on STDOUT, not stderr, so
      #     2>/dev/null does not stop it and $_cc ends up holding
      #     "NVIDIA-SMIhasfailedbecause..." -- prose, in a variable the next
      #     line compares as a number. `a+0` makes prose 0, so the comparison
      #     happened to be harmless; it is harmless BY ACCIDENT, and the die
      #     message one line down would have printed the prose as a compute
      #     capability. Keep only something shaped like one.
      #
      # The login node has no nvidia-smi at all, which is why neither of these
      # ever showed up there.
      if [ "$GPU" = "1" ] && [ -n "${GPU_MAX_CC:-}" ] && command -v nvidia-smi >/dev/null 2>&1; then
        _cc=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ') || _cc=""
        case "$_cc" in
          ''|*[!0-9.]*) _cc="" ;;
        esac
        if [ -n "$_cc" ] && awk -v a="$_cc" -v b="$GPU_MAX_CC" 'BEGIN{exit !(a+0 > b+0)}'; then
          die "$NAME cannot run on this GPU.
  device compute capability : $_cc  ($(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1))
  image supports up to      : $GPU_MAX_CC
This is the sm_120 problem in doc 05, not a broken image. Ask for the right
model instead of a bare --gres=gpu:1:
  #SBATCH --gres=gpu:nvidia_l40s:1        # or nvidia_h100_nvl"
        fi
      fi
      # shellcheck disable=SC2086
      exec apptainer $_args ${CHPC_TOOL_BIND:+--bind "$CHPC_TOOL_BIND"} "$_sif" "$@" ;;
    native)
      [ $# -gt 0 ] || die "$NAME: no command given"
      if [ -n "${PREFIX:-}" ] && [ -d "$PREFIX/bin" ]; then PATH="$PREFIX/bin:$PATH"; export PATH; fi
      exec "$@" ;;
    module)
      [ $# -gt 0 ] || die "$NAME: no command given"
      [ -n "${MODULE:-}" ] || die "$NAME: KIND=module but MODULE names nothing"
      # Lmod is a shell FUNCTION, so a non-interactive shell has to source its
      # init first or `module` is simply not found. And it must never be piped
      # or otherwise run in a subshell: the environment change would happen in
      # the subshell and never reach us, which looks exactly like the module
      # not existing.
      # `set -u` has to come off around this. CoreHPC's /etc/profile.d/lmod.sh
      # reads $SLURM_NODELIST unguarded at line 10, so sourcing it under
      # `set -u` dies with "SLURM_NODELIST: unbound variable" outside a job --
      # which looks like a broken tool and is really a broken init script we do
      # not own. Verified on the login node 2026-09-17.
      set +u
      # Only initialise Lmod if it is NOT already here, and never otherwise.
      # bash exports the `module` function and MODULEPATH into child
      # processes, so a script launched from a login shell already has a
      # working, fully populated Lmod. Re-sourcing the init in that situation
      # REBUILDS MODULEPATH from the system default and silently drops
      # /etc/modulefiles and /etc/scl/modulefiles from the front of it -- and
      # /etc/modulefiles is where the Sali, CBI and RAD collections live. The
      # symptom is Lmod saying a module "exists but cannot be loaded as
      # requested", which reads like a broken modulefile and is really a
      # MODULEPATH we destroyed one line earlier. Verified 2026-09-17.
      if ! command -v module >/dev/null 2>&1; then
        # /etc/profile.d/lmod.sh is the one that exists on CoreHPC; the others
        # are here for a differently packaged Lmod elsewhere.
        for _i in /etc/profile.d/lmod.sh /usr/share/lmod/lmod/init/bash /etc/profile.d/z00_lmod.sh; do
          if [ -f "$_i" ]; then . "$_i"; break; fi
        done
      fi
      if ! command -v module >/dev/null 2>&1; then
        set -u; die "$NAME: KIND=module but no Lmod here (cluster only)"
      fi
      # The CBI/Sali/RAD collections are modulefiles under /etc, which the
      # OpenHPC default MODULEPATH does not include. A shell that inherited a
      # login environment already has them; one started clean (env -i, or a
      # job submitted without --export=ALL) does not, and then `module load
      # Sali` fails. Put them back rather than depend on how we were invoked.
      for _p in /etc/modulefiles /etc/scl/modulefiles; do
        if [ -d "$_p" ]; then
          case ":${MODULEPATH:-}:" in
            *":$_p:"*) ;;
            *) MODULEPATH="$_p${MODULEPATH:+:$MODULEPATH}"; export MODULEPATH ;;
          esac
        fi
      done
      # One at a time, in order. MODULE="Sali dssp/2.2.1" is a HIERARCHY: dssp
      # is not visible until the Sali collection is loaded, and a single
      # `module load Sali dssp/2.2.1` fails with "module(s) or extension(s)
      # exist but cannot be loaded as requested". Verified 2026-09-17.
      for _m in $MODULE; do module load "$_m"; done
      set -u
      exec "$@" ;;
    conda|venv)
      die "$NAME: KIND=$KIND has no exec form -- use \`chpc-tool export $NAME\` and call the interpreter it names" ;;
    *) die "$NAME: unknown KIND '$KIND'" ;;
  esac
}

# doctor ---------------------------------------------------------------------
_drow() { printf '  %-14s %-6s %s\n' "$1" "$2" "${3:-}"; }

# A tool that STATUS says is built, but which is not there. On the cluster that
# is a real failure. Off the cluster it means nothing at all -- /mnt/fac is not
# mounted on a laptop -- so it must not be reported as broken, or `doctor` on a
# Mac would condemn every correctly installed tool on the share.
_absent() {
  if [ "$CHPC_ON_CLUSTER" = "1" ]; then _drow "$1" "FAIL" "$2"; return 1; fi
  _drow "$1" "----" "cannot check from here: $2"; return 2
}

# Runs in a subshell so one entry's variables cannot leak into the next, which
# is why it reports its verdict through the EXIT STATUS and the caller tallies:
# 0 ok, 2 planned, 1 broken. Incrementing a counter in here would increment it
# in the subshell and the totals would always read zero.
_doctor_one() {
  _load "$1"
  _drift=""
  if [ "$STATUS" = "planned" ]; then
    _drow "$NAME" "----" "planned -- described only, nothing built yet"
    return 2
  fi
  # `external` is the fourth rung, and it is a TERMINUS rather than a stop on
  # the way to `verified`. Some tools are not installed here because they are
  # not installable here: funclib and pross are Weizmann web servers whose only
  # local form is a Rosetta protocol nobody has written. Left at `planned` they
  # read as a queue of pending builds and someone eventually asks when the
  # image is coming; the answer is never, and the registry should say so in the
  # status column rather than three paragraphs into a NOTE. There is nothing on
  # any filesystem to check, so this returns 2 like `planned` and the row lands
  # in "not checked".
  if [ "$STATUS" = "external" ]; then
    _drow "$NAME" "----" "external -- used off-cluster, nothing installed here by design"
    return 2
  fi
  # A tool whose location depends on something the CALLER has to supply cannot
  # be checked until they supply it, and guessing produces a confident FAIL
  # about a path nobody meant. python-bio is the case: its PREFIX contains
  # $CHPC_PYENV, so with none set, doctor looked for a generic `bio` env that
  # was never supposed to exist and reported the registry's only breakage.
  # A false FAIL is worse than no row -- it is the thing that teaches people to
  # skim past doctor's output. Returning 2 puts it in "not checked", where
  # planned tools already live, and the message says what to pass.
  if type tool_precheck >/dev/null 2>&1; then
    _st=0; _out=$(tool_precheck 2>&1) || _st=$?
    if [ "$_st" -eq 2 ]; then _drow "$NAME" "----" "${_out:-not checked}"; return 2; fi
    if [ "$_st" -ne 0 ]; then _drow "$NAME" "FAIL" "${_out:-tool_precheck failed}"; return 1; fi
  fi
  case "$KIND" in
    container)
      _sif=$(_image_path)
      if [ ! -r "$_sif" ]; then
        # Name BOTH places, because the whole point of the fallback is that
        # they can disagree, and "no image at <one path>" sent someone looking
        # in the wrong one once already.
        _dc=$(_image_canon_path)
        if [ -n "$_dc" ] && [ "$_dc" != "$_sif" ]; then
          _absent "$NAME" "no image at $_sif nor $_dc"; return $?
        fi
        _absent "$NAME" "no image at $_sif"; return $?
      fi
      # The fallback fired: the image is usable and the mirror is stale. Carry
      # that as a SEPARATE note rather than folding it into _where, because a
      # tool_doctor that produces its own message replaces _where entirely --
      # so a drift warning written there would be visible on exactly the
      # entries that have no tool_doctor, and silent on chai1, protenix and
      # boltz, which is to say on the ones this mattered for.
      _dm=$(_image_mirror_path)
      if [ -n "$_dm" ] && [ "$_sif" != "$_dm" ]; then
        _drift=" [not in the scratch mirror -- run chpc-stage-containers]"
      fi
      _where="$_sif" ;;
    native)
      [ -n "${PREFIX:-}" ] || { _drow "$NAME" "FAIL" "KIND=native but PREFIX is unset"; return 1; }
      [ -d "$PREFIX" ] || { _absent "$NAME" "no install at $PREFIX"; return $?; }
      _where="$PREFIX" ;;
    module)
      [ -n "${MODULE:-}" ] \
        || { _drow "$NAME" "FAIL" "KIND=module but MODULE names nothing"; return 1; }
      # There is no Lmod on a laptop, so "the module is there" is not a
      # question that can be answered from here -- and answering OK would be
      # a lie about software we cannot see.
      if [ "$CHPC_ON_CLUSTER" != "1" ]; then
        _drow "$NAME" "----" "cannot check from here: needs Lmod (module load $MODULE)"
        return 2
      fi
      _where="module load $MODULE" ;;
    conda|venv)
      [ -n "${PREFIX:-}" ] || { _drow "$NAME" "FAIL" "KIND=$KIND but PREFIX is unset"; return 1; }
      [ -x "$PREFIX/bin/python" ] || { _absent "$NAME" "no interpreter at $PREFIX/bin/python"; return $?; }
      _where="$PREFIX" ;;
    *) _drow "$NAME" "FAIL" "unknown KIND '$KIND'"; return 1 ;;
  esac
  # A tool can be present and still not work: an expired licence, weights that
  # a scratch purge took. That is what tool_doctor is for.
  if type tool_doctor >/dev/null 2>&1; then
    _st=0; _out=$(tool_doctor 2>&1) || _st=$?
    if [ "$_st" -ne 0 ]; then _drow "$NAME" "FAIL" "${_out:-tool_doctor failed}"; return 1; fi
    _drow "$NAME" "OK" "${_out:-$_where}$_drift"
  else
    _drow "$NAME" "OK" "$_where$_drift"
  fi
  return 0
}

# The copy of chpc.env published on the share is what jobs and interactive
# shells actually source; the one in this checkout is what the registry was
# written against. Nothing keeps them in step, and when the share's copy lags,
# the symptom is a registry variable that is simply empty -- so a path resolves
# to /software or /data and the error names the tool rather than the env file.
# This is a warning, not a failure: a student's checkout is often newer than
# the share on purpose, and doctor's job is to say so, not to refuse.
_check_shared_env() {
  _repo_env="$SELF_DIR/../chpc.env"
  _fac_env="${CHPC_LAB:-}/chpc.env"
  [ -f "$_repo_env" ] || return 0
  [ -n "${CHPC_LAB:-}" ] && [ -f "$_fac_env" ] || return 0
  cmp -s "$_repo_env" "$_fac_env" && return 0
  echo "note: $_fac_env differs from this checkout's lab/chpc.env"
  # Name the consequence, not just the fact. A variable the share's copy never
  # sets is the case that actually breaks things.
  for _v in CHPC_SOFTWARE CHPC_REFDATA CHPC_LICENSES CHPC_TOOLS CHPC_CONTAINERS; do
    if grep -q "^export $_v=" "$_repo_env" 2>/dev/null \
       && ! grep -q "^export $_v=" "$_fac_env" 2>/dev/null; then
      echo "      the share's copy does not set \$$_v -- publish it with:"
      echo "        cp corehpc/lab/chpc.env \"\$CHPC_LAB/chpc.env\""
      break
    fi
  done
}

cmd_doctor() {
  if [ $# -eq 0 ]; then set -- $(_all_tools); fi
  _ok=0; _skip=0; _bad=0
  echo "tool registry: $TOOLS"
  _check_shared_env
  if [ "$CHPC_ON_CLUSTER" != "1" ]; then
    echo "not on a CoreHPC node: the paths below are where things WOULD be, and"
    echo "\$USER here (${USER:-?}) is not necessarily your campus username -- source"
    echo "corehpc/env.sh first if any path should be user-specific."
  fi
  echo
  for _t in "$@"; do
    _rc=0; ( _doctor_one "$_t" ) || _rc=$?
    case "$_rc" in
      0) _ok=$((_ok+1)) ;;
      2) _skip=$((_skip+1)) ;;
      *) _bad=$((_bad+1)) ;;
    esac
  done
  echo
  # "not checked" rather than "planned": a row is skipped either because it is
  # only described, or because it is real but unverifiable from this machine.
  printf '  %d ok, %d not checked, %d broken\n' "$_ok" "$_skip" "$_bad"
  [ "$_bad" -eq 0 ] || return 1
  return 0
}

# Run an entry's test.sh. The registry says STATUS=verified means "test.sh has
# passed on a compute node", and until this existed nothing actually ran it --
# so `verified` was an assertion by whoever edited tool.conf rather than a
# result. This makes it checkable.
#
# The test script is handed the tool's own environment: $TOOL, $CHPC_TOOL (this
# script, by absolute path), $TOOLDIR, and everything tool_exports emits. It
# runs in a scratch working directory, because several of these tools write
# into $PWD whether asked to or not.
cmd_test() {
  [ $# -ge 1 ] || die "usage: chpc-tool test <tool>..."
  _fails=0
  for _t in "$@"; do
    _rc=0
    (
      _load "$_t"
      _ts="$TOOLDIR/test.sh"
      [ -f "$_ts" ] || die "$NAME: no test.sh in $TOOLDIR (required for STATUS=verified)"
      _export_tool_vars
      TOOL="$NAME"; CHPC_TOOL="$_self"; export TOOL CHPC_TOOL TOOLDIR
      _wd=$(mktemp -d "${TMPDIR:-/tmp}/chpc-test-$NAME.XXXXXX")
      # A tool that writes into the current directory -- and RFdiffusion,
      # cartesian_ddg and hydra apps all do -- must not do it in the registry.
      cd "$_wd" || exit 1
      echo "--- $NAME: $_ts"
      sh "$_ts"
      _r=$?
      cd /; rm -rf "$_wd"
      exit $_r
    ) || _rc=$?
    if [ "$_rc" -eq 0 ]; then
      echo "PASS $_t"
    else
      echo "FAIL $_t (exit $_rc)"
      _fails=$((_fails + 1))
    fi
  done
  [ "$_fails" -eq 0 ] || die "$_fails of $# failed"
}

# Which .def builds this entry. Pairs it with IMAGE rather than taking
# whatever sorts first, which is what this used to do and was wrong the moment
# an entry was rebuilt: `ls -1 *.def | head -1` picks chai1_1.def next to
# chai1_2.def and protenix_1.def next to protenix_2.def, so `chpc-tool build`
# compiled the OLD recipe and wrote it under the NEW image name. An image that
# is a version behind its own name is not a failure anyone reads as a build
# bug -- it is a tool that mysteriously still has the defect the rebuild was
# for, which is how chai1_2 would have shipped without kalign.
#
# An entry with a single .def whose name does not match IMAGE still uses it:
# that is the old behaviour and there is nothing ambiguous to protect. Several
# .def files and no match is the case that must not guess.
_deffile() {
  _d="$TOOLDIR/${IMAGE%.sif}.def"
  if [ -f "$_d" ]; then echo "$_d"; return 0; fi
  _n=$(ls -1 "$TOOLDIR"/*.def 2>/dev/null | wc -l)
  if [ "$_n" -eq 1 ]; then ls -1 "$TOOLDIR"/*.def; return 0; fi
  if [ "$_n" -eq 0 ]; then return 0; fi
  die "$NAME: IMAGE=$IMAGE wants $(basename "$_d"), which is not in $TOOLDIR, and $_n .def files are. Name the recipe after the image, or fix IMAGE."
}

cmd_build() {
  [ $# -ge 1 ] || die "usage: chpc-tool build <tool>"
  _load "$1"
  [ "$KIND" = container ] || die "$NAME: KIND=$KIND, nothing to build. See $TOOLDIR/README.md"
  _def=$(_deffile)
  [ -n "$_def" ] || die "$NAME: no .def in $TOOLDIR"
  _bld="$SELF_DIR/../../templates/apptainer/build.sh"
  [ -x "$_bld" ] || die "no build helper at $_bld (is this a full checkout?)"
  _name="${IMAGE%.sif}"
  echo "building $NAME from $(basename "$_def") -> ${_name}.sif"
  echo "note: the login node is the only node with internet, and it kills heavy builds."
  exec "$_bld" "$_def" "$_name"
}

cmd_wrapper() {
  [ $# -ge 1 ] || die "usage: chpc-tool wrapper <tool> [<path>]"
  _load "$1"
  [ "$KIND" = container ] || die "$NAME: wrappers are for containers"
  _src="$SELF_DIR/run-in-container"
  [ -f "$_src" ] || die "no $_src"
  _dst="${2:-$CHPC_LAB/bin/$NAME}"
  mkdir -p "$(dirname "$_dst")"
  # Two plain assignments, each on its own line and each present once in
  # run-in-container, are all a wrapper carries: the tool's name and its
  # ENTRY. Everything else it asks chpc-tool for at run time, so a rebuilt
  # image (a new IMAGE in tool.conf) needs no new wrapper.
  sed -e "s|^TOOL=.*|TOOL=$NAME|" \
      -e "s|^ENTRY=.*|ENTRY=\"${ENTRY:-}\"|" "$_src" > "$_dst"
  grep -q "^TOOL=$NAME\$" "$_dst" \
    || die "generated wrapper did not pick up TOOL=$NAME; $_src has changed shape"
  # Without ENTRY the wrapper runs its first argument as a program, so
  # `foldseek version` fails with `"version": executable file not found`.
  # It looks like a broken image and is a wrapper that forgot what it wraps.
  grep -q "^ENTRY=\"${ENTRY:-}\"\$" "$_dst" \
    || die "generated wrapper did not pick up ENTRY=${ENTRY:-}; $_src has changed shape"
  grep -q 'exec "$_ct" exec "$TOOL" --' "$_dst" \
    || die "generated wrapper does not hand over to chpc-tool exec; $_src has changed shape"
  chmod 755 "$_dst"
  echo "wrote $_dst  (chpc-tool exec $NAME -- ${ENTRY:-<program>} ...)"
}

cmd_publish() {
  [ $# -ge 1 ] || die "usage: chpc-tool publish <tool>"
  _load "$1"
  [ "$KIND" = container ] || die "$NAME: publish is for containers"
  _built="${CHPC_USER_SCRATCH:-/mnt/scratch/user/${CHPC_USER:-$USER}}/apptainer/$IMAGE"
  [ -r "$_built" ] || die "no built image at $_built -- run: chpc-tool build $NAME"
  # The same pairing as the build, because this line is what gets COPIED into
  # containers/defs/ and recorded in the provenance table. Publishing the
  # wrong recipe beside the right image is a worse outcome than building it:
  # the image is at least testable, while the record of how it was made is
  # only ever read long after anyone could check.
  _def=$(_deffile)
  echo "publishing $NAME $VERSION"
  mkdir -p "$CHPC_LAB/containers/defs"
  cp "$_built" "$CHPC_LAB/containers/$IMAGE"
  chmod 644 "$CHPC_LAB/containers/$IMAGE"
  [ -n "$_def" ] && cp "$_def" "$CHPC_LAB/containers/defs/"
  cmd_wrapper "$NAME"
  # Must match the six-column header already in that file:
  #   | Image | What | Source / def | Built by | Date | Run |
  if [ -n "$_def" ]; then _srccol="defs/$(basename "$_def")"; else _srccol="${UPSTREAM:--}"; fi
  printf '| `%s` | %s %s | %s | %s | %s | `chpc-tool exec %s -- ...` |\n' \
    "$IMAGE" "$NAME" "${VERSION:--}" "$_srccol" \
    "${CHPC_USER:-$USER}" "$(date -u +%Y-%m-%d)" "$NAME" \
    >> "$CHPC_LAB/containers/README.md"
  "$SELF_DIR/chpc-stage-containers"
  echo
  echo "Published. Still yours to do (tools/README.md, Add a tool):"
  echo "  - if it has not run on a compute node yet:  chpc-tool test $NAME"
  echo "  - STATUS=verified and UPSTREAM_REF in $TOOLDIR/tool.conf, the README, and commit"
}

usage() { sed -n '2,22p' "$_self" | sed 's/^# \{0,1\}//'; }

# --- dispatch ------------------------------------------------------------------
[ $# -ge 1 ] || { usage; exit 2; }
_sub="$1"; shift
case "$_sub" in
  list)    cmd_list "$@" ;;
  show)    cmd_show "$@" ;;
  path)    cmd_path "$@" ;;
  export)  cmd_export "$@" ;;
  exec)    cmd_exec "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  test)    cmd_test "$@" ;;
  build)   cmd_build "$@" ;;
  publish) cmd_publish "$@" ;;
  wrapper) cmd_wrapper "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown subcommand '$_sub'. Try: chpc-tool --help" ;;
esac
