Bootstrap: docker
From: python:3.12-slim

# DockQ v2 -- quality measure for predicted multimers, nucleic acids and
# small-molecule complexes.
#
# CPU-only and small. No CUDA base, no --nv, no weights: DockQ is arithmetic
# over two structure files, and every other choice here follows from that.
# python:3.12-slim rather than a CUDA image keeps it under a GB instead of
# several, which matters because this is the one tool in the covalent family
# that will be invoked thousands of times per campaign rather than dozens.
#
# A C COMPILER IS REQUIRED, AND THE FIRST VERSION OF THIS RECIPE ARGUED AT
# LENGTH THAT IT WAS NOT. That argument was about the wrong compiler: it
# reasoned about JIT kernels compiled at first USE (boltz's cuequivariance and
# Triton, DeepSpeed's op builder) and correctly concluded DockQ has none. DockQ
# needs gcc at INSTALL time, which is a different question nobody asked. The
# package ships src/DockQ/operations.pyx plus its generated operations.c and
# builds them as a Cython extension, so a pip install on a slim base dies in
# build_ext with
#     error: [Errno 2] No such file or directory: 'gcc'
# after several minutes of apparently healthy output (measured here
# 2026-09-26). The lesson generalises past this entry: "does it need a
# compiler" has to be asked of the wheel, not only of the runtime, and the
# cheap way to ask is to look for a .pyx, a .c or an ext_modules in the
# sdist before reasoning about it.
#
# The fallback makes this worse, not better. DockQ ships operations_nocy.py, a
# pure-Python implementation, and imports it when the extension is missing. So
# a compiler-less image would have installed, imported, answered --help and
# scored correctly -- just far slower, silently, on the tool this registry
# expects to run thousands of times. %post asserts the COMPILED module is the
# one that loaded, because the fallback is exactly the kind of wrong answer
# that passes every naive check.
#
# gcc stays in the finished image rather than being purged after the build.
# It costs a few hundred MB against a 5 TB share, and it is the difference
# between a future DockQ growing a numba or Cython fast path and working, and
# it failing inside a read-only squashfs for reasons the job log will not
# explain.
#
# Build:  chpc-tool build dockq          (login node only; /usr/bin/apptainer
#                                         1.5.2, --fakeroot UNAVAILABLE, and
#                                         `module load apptainer` does not
#                                         exist on this cluster)

%labels
    Tool         dockq
    Version      2
    Upstream     https://github.com/bjornwallner/DockQ
    UpstreamRef  DockQ (PyPI), exact version recorded in README.md at build time
    Licence      MIT
    Base         python:3.12-slim
    Citation     Mirabello and Wallner, Bioinformatics 2024, 10.1093/bioinformatics/btae586
    Maintainer   Craik Lab, UCSF

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # build-essential, not just gcc: the Cython extension needs the
    # toolchain's libc headers as well as the compiler itself.
    apt-get install -y --no-install-recommends ca-certificates build-essential
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade DockQ

    python - <<'CHECK'
import sys
assert sys.version_info[:2] >= (3, 10), sys.version
print("python", sys.version.split()[0])

from importlib.metadata import version
print("DockQ", version("DockQ"))

# THE ASSERTION THIS RECIPE EXISTS FOR. DockQ falls back to a pure-Python
# operations_nocy when its Cython extension is absent, so "it imports" and
# "it scores correctly" are both true of an image that is quietly several
# times slower. Prove the compiled extension is the module that loaded.
import DockQ.operations as ops
assert not ops.__file__.endswith(".py"), (
    "DockQ.operations loaded from %s -- that is the pure-Python fallback, "
    "so the Cython extension did not build. Check gcc is installed." % ops.__file__)
print("operations", ops.__file__.rsplit("/", 1)[-1], "(compiled extension)")

import importlib.util
for mod in ("numba", "triton"):
    print("%-8s %s" % (mod, "present -- NUMBA_CACHE_DIR matters, see %environment"
                       if importlib.util.find_spec(mod) else "absent"))
for mod in ("numpy", "Bio", "Cython"):
    print("%-8s %s" % (mod, "present" if importlib.util.find_spec(mod) else "ABSENT"))
CHECK
    command -v DockQ

%environment
    export LC_ALL=C.UTF-8
    export PYTHONNOUSERSITE=1
    # Set defensively and cheaply: if a future DockQ acquires a numba path,
    # this is the difference between it working inside a read-only squashfs
    # and refusing at import (doc 07). /tmp is bound by apptainer, is local
    # NVMe on every compute node, and is per-node so concurrent array tasks
    # cannot collide over one cache file.
    export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-/tmp/numba-cache}"

%test
    set -eu
    # Against the BUILT, read-only image -- %post runs on a writable overlay,
    # so an import that only fails on squashfs cannot be caught there (doc 07).
    # %post ran on a writable overlay; this runs on the finished read-only
    # squashfs, which is where an import can fail for reasons %post cannot see.
    python -c "import DockQ.operations as o; assert not o.__file__.endswith('.py'), o.__file__; print('compiled operations ok')"
    DockQ --help > /dev/null

%runscript
    exec DockQ "$@"

%help
    DockQ v2 -- Mirabello and Wallner, Bioinformatics 2024.

      chpc-tool exec dockq -- DockQ model.pdb native.pdb --mapping AB:AB --json out.json

    PASS --mapping. Model chains and native chains are different alphabets,
    and DockQ will search chain permutations and report the best one it finds.
    A wrong mapping does not error; it produces a plausible number. In bulk
    scoring that is indistinguishable from a result.

    --small_molecule scores small-molecule poses. Nucleic-acid interfaces are
    scored alongside protein ones.

    CAPRI thresholds: <0.23 Incorrect, 0.23-0.49 Acceptable, 0.49-0.80 Medium,
    >=0.80 High quality.

    CPU only. Send it to the `cpu` partition, or `community_short`, which is
    capped at 1 h and REQUIRES --qos=cmnt_short. It has no business queueing
    behind the gpu partition's 8-GPU, 21-job per-user cap.
