Bootstrap: docker
From: condaforge/miniforge3:24.11.3-2

# AmberTools 26 -- system preparation, parameterisation and trajectory analysis.
#
# THE FREE HALF OF AMBER, AND A SEPARATE ENTRY FOR THAT REASON. Amber ships as
# two pieces with two licences: AmberTools is open source (GPL-3.0-or-later AND
# LGPL-3.0-or-later AND BSD-3-Clause AND MIT, per conda-forge) and the pmemd
# engine -- including pmemd.cuda, the thing people mean when they say "run
# Amber on a GPU" -- needs a paid site licence. Carrying both in one entry
# meant the free 90% waited on the paid 10%: `amber` sat at STATUS=planned with
# a tool_doctor that failed on a missing pmemd.cuda, so nothing in the
# toolchain was available at all.
#
# So AmberTools is here, buildable today, and ../amber is the licensed engine.
# What this gives the lab immediately is the whole preparation and analysis
# path -- tleap, antechamber, parmchk2, parmed, cpptraj, pdb4amber, MMPBSA --
# and Amber-parameterised systems that ../openmm can then integrate on a GPU
# with no licence anywhere in the chain. That composition is the point.
#
# Build:  chpc-tool build ambertools        (login node)

%labels
    Tool         ambertools
    Version      26
    Upstream     https://ambermd.org/
    UpstreamRef  conda-forge ambertools 26.0
    Licence      GPL-3.0-or-later AND LGPL-3.0-or-later AND BSD-3-Clause AND MIT
    Base         condaforge/miniforge3:24.11.3-2
    Citation     Case et al., Amber 2024/2026; cite the AmberTools paper for the tools used
    Maintainer   Craik Lab, UCSF

%post
    set -eux

    # AmberTools pulls a large dependency tree (netcdf, fftw, boost, an MPI, a
    # fortran runtime). Let conda resolve it rather than pinning pieces: the
    # feedstock is the thing that knows which netcdf goes with which parmed.
    mamba create -y -p /opt/env -c conda-forge "python=3.12" "ambertools=26.0"
    mamba clean -afy

    export PATH=/opt/env/bin:$PATH
    export AMBERHOME=/opt/env

    # --- the binaries this entry exists to provide ---------------------------
    # A conda solve that quietly dropped a subpackage still leaves an
    # environment that imports and a PATH that looks populated, so name them.
    for b in tleap antechamber parmchk2 parmed cpptraj pdb4amber sander; do
        command -v "$b" || { echo "FATAL: $b missing from the solve" >&2; exit 1; }
    done

    # --- assert the FORCE FIELD DATA, not just the binaries ------------------
    # tleap is a script interpreter: it runs, prints a banner and exits 0 with
    # nothing built if it cannot find its leaprc files. That is the failure
    # worth catching here, because it looks exactly like success.
    test -d "$AMBERHOME/dat/leap/cmd" \
        || { echo "FATAL: no leap command directory under $AMBERHOME" >&2; exit 1; }
    ls "$AMBERHOME/dat/leap/cmd" | head -20
    for f in leaprc.protein.ff14SB leaprc.water.tip3p leaprc.gaff2; do
        test -s "$AMBERHOME/dat/leap/cmd/$f" \
            || { echo "FATAL: missing force field $f" >&2; exit 1; }
    done

    # --- build a real system, in %post, and count the atoms ------------------
    # The end-to-end check: tleap must parameterise something and write a
    # topology cpptraj can read back. An empty or truncated prmtop is still a
    # file; the atom count is what distinguishes it.
    # --- NEVER BUILD OR RUN PYTHON FROM /tmp IN %post -------------------------
    # /tmp on the login node is shared and world-writable, apptainer binds the
    # HOST /tmp into the container, and python puts the working directory on
    # sys.path. So a file another user left in /tmp shadows a standard library
    # module for anything built here.
    #
    # Measured, not hypothetical: this build died with
    #   File "/tmp/inspect.py", line 3, in <module>
    #   FileNotFoundError: .../thzhou/project1_text_supervised/.../case_error_flags.json
    # because `import inspect` -- reached from numpy, via parmed -- resolved to
    # another user's analysis script that has been sitting in /tmp since July.
    # Nothing in that traceback suggests a shared directory; it reads as a
    # broken numpy.
    #
    # A private directory under /opt fixes it, and `python -P` (3.11+, do not
    # prepend the cwd to sys.path) makes the fix independent of the directory.
    mkdir -p /opt/build-check
    cd /opt/build-check
    cat > build.leap <<'LEAP'
source leaprc.protein.ff14SB
source leaprc.water.tip3p
peptide = sequence { ACE ALA ALA ALA NME }
solvateBox peptide TIP3PBOX 8.0
saveAmberParm peptide test.prmtop test.inpcrd
quit
LEAP
    tleap -f build.leap > tleap.log 2>&1 || { cat tleap.log; exit 1; }
    tail -20 tleap.log
    test -s test.prmtop || { echo "FATAL: tleap wrote no topology" >&2; cat tleap.log; exit 1; }
    test -s test.inpcrd || { echo "FATAL: tleap wrote no coordinates" >&2; exit 1; }

    python -P - <<'CHECK'
import parmed
p = parmed.load_file("test.prmtop", xyz="test.inpcrd")
n_atoms = len(p.atoms)
n_res = len(p.residues)
waters = sum(1 for r in p.residues if r.name in ("WAT", "HOH"))
print("prmtop: %d atoms, %d residues, %d waters" % (n_atoms, n_res, waters))
# A capped tetra-alanine is 5 residues; anything less means tleap built nothing
# and the box is the only thing in the file.
assert n_res - waters == 5, ("solute residues", n_res - waters)
assert waters > 50, ("solvateBox produced almost no water", waters)
# Charges must be assigned, not left at zero: a topology with no charges
# parameterises and simulates and is physically meaningless.
charges = [a.charge for a in p.atoms]
assert any(abs(c) > 1e-6 for c in charges), "every partial charge is zero"
# ff14SB gives a neutral capped polyalanine; the total must be ~0.
total = sum(charges)
assert abs(total) < 1e-3, ("net charge should be ~0 for capped polyalanine", total)
print("charges assigned, net charge %.6f" % total)
# And the box was actually set, which solvateBox is responsible for.
assert p.box is not None, "no periodic box in the topology"
print("box", [round(x, 2) for x in p.box])
CHECK

    # cpptraj reads the same pair, independently of parmed, and must agree.
    # COMMANDS GO IN A FILE, passed with -i. There is no flag for inline
    # commands: `-ec '...'` is not cpptraj syntax, and cpptraj answers an
    # unrecognised flag by printing its whole usage screen, appending
    # "Error: Error(s) occurred during execution." and exiting non-zero -- which
    # buries the one useful line under fifty lines of help text.
    cat > analyse.in <<'CPPTRAJ'
strip :WAT
go
CPPTRAJ
    cpptraj -p test.prmtop -y test.inpcrd -i analyse.in > cpptraj.log 2>&1 || { cat cpptraj.log; exit 1; }
    # `grep -q PATTERN file && { fail; }` IS A TRAP UNDER set -e, and it was in
    # this recipe. When grep finds nothing -- the HEALTHY case -- the && list's
    # exit status is grep's 1, the braces never run, and `set -e` kills the build
    # with no message of its own. So a clean cpptraj run failed the build while a
    # dirty one would have reported properly. Always `if grep ...; then`.
    # 'Error:' with the colon, not a bare 'error': cpptraj's banner and its
    # citation text contain the word in prose, and matching that would fail a
    # healthy run for the opposite reason.
    if grep -qE '^Error:|^ *Error:' cpptraj.log; then
        echo "FATAL: cpptraj reported an error" >&2
        cat cpptraj.log >&2
        exit 1
    fi
    tail -12 cpptraj.log

    cd / && rm -rf /opt/build-check
    chmod -R a+rX /opt/env

    # --- say out loud what is NOT here --------------------------------------
    # pmemd is the licensed half. Record its absence in the build log so a
    # reader of the log is never left wondering whether the solve dropped it.
    for b in pmemd pmemd.cuda pmemd.MPI; do
        if command -v "$b" >/dev/null 2>&1; then
            echo "UNEXPECTED: $b is present in a conda-forge ambertools build" >&2
        else
            echo "as expected, no $b -- licensed engine, see tools/amber"
        fi
    done

%environment
    export PATH=/opt/env/bin:$PATH
    export AMBERHOME=/opt/env
    export PYTHONNOUSERSITE=1
    export LC_ALL=C.UTF-8
    # cpptraj and sander parallelise with OpenMP and will otherwise grab every
    # core they can see -- which on a shared node is every core on the machine,
    # not the ones Slurm gave the job. Honour the allocation when there is one.
    export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-${OMP_NUM_THREADS:-1}}"

%test
    set -eu
    # On the finished read-only squashfs. tleap writes into the current
    # directory, so this runs in /tmp, which apptainer binds writable.
    # Not /tmp: see the note in %post about another user's inspect.py. A
    # writable per-invocation directory instead.
    w=$(mktemp -d)
    cd "$w"
    printf 'source leaprc.protein.ff14SB\nquit\n' > t.leap
    /opt/env/bin/tleap -f t.leap > t.log 2>&1
    # ASSERT SUCCESS, DO NOT SEARCH FOR THE WORD "error". tleap ends every run,
    # including a perfectly clean one, with
    #     Exiting LEaP: Errors = 0; Warnings = 0; Notes = 0.
    # so `grep -qi error` matches ALWAYS and failed this %test on a healthy
    # image. Same lesson as the cpptraj check in %post one screen up: match what
    # the tool emits on the path you care about, which here is a zero count.
    grep -q 'Errors = 0' t.log || { echo "tleap did not report zero errors:"; cat t.log; exit 1; }
    /opt/env/bin/cpptraj --version
    /opt/env/bin/python -P -c "import parmed; print('parmed', parmed.__version__)"
    test -s /opt/env/dat/leap/cmd/leaprc.protein.ff14SB
    cd / && rm -rf "$w"
    echo "AmberTools responds on the squashfs"

%runscript
    exec "$@"

%help
    AmberTools 26.0 from conda-forge: the OPEN SOURCE half of Amber.
    AMBERHOME is /opt/env and the force field data is baked in.

      chpc-tool exec ambertools -- tleap -f build.leap
      chpc-tool exec ambertools -- antechamber -i lig.mol2 -fi mol2 -o lig.mol2 -fo mol2 -c bcc
      chpc-tool exec ambertools -- cpptraj -p sys.prmtop -y traj.nc -i analyse.in
      chpc-tool exec ambertools -- python -c "import parmed"

    WHAT IS NOT HERE: pmemd and pmemd.cuda. Those are the licensed engine and
    they live in tools/amber, which is blocked on a site licence. `sander` is
    included and will run MD, but it is CPU-only and far slower.

    THE ROUTE THAT NEEDS NO LICENCE AT ALL: prepare and parameterise here with
    tleap and antechamber, then integrate on a GPU with tools/openmm, which
    reads Amber prmtop/inpcrd directly through openmm.app.AmberPrmtopFile.
    Analyse the trajectory back here with cpptraj.
