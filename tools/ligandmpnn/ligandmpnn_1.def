Bootstrap: docker
From: pytorch/pytorch:2.14.0-cuda13.2-cudnn9-runtime

# LigandMPNN -- ProteinMPNN that can see ligands, substrates and cofactors.
#
# NOT built from the repo's requirements.txt. That file is a `pip freeze` of
# one developer's 2024 machine -- it pins torch==2.2.1, numpy==1.23.5 and a
# complete set of nvidia-*-cu12 12.1 wheels -- so honouring it would tear out
# the CUDA 13.2 stack this base exists to provide and replace it with one three
# years older than the driver. The genuine dependencies are the four non-torch
# packages below; the build asserts they import, which is the check that
# actually matters.
#
# Build:  chpc-tool build ligandmpnn

%labels
    Tool         ligandmpnn
    Version      1
    Upstream     https://github.com/dauparas/LigandMPNN
    UpstreamRef  26ec57ac976ade5379920dbd43c7f97a91cf82de
    Licence      MIT
    Base         pytorch/pytorch:2.14.0-cuda13.2-cudnn9-runtime
    Maintainer   Craik Lab, UCSF

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends git wget ca-certificates
    rm -rf /var/lib/apt/lists/*

    REF=26ec57ac976ade5379920dbd43c7f97a91cf82de
    git clone https://github.com/dauparas/LigandMPNN /opt/LigandMPNN
    git -C /opt/LigandMPNN checkout --detach "$REF"
    git -C /opt/LigandMPNN rev-parse HEAD > /opt/LigandMPNN/.built-from
    rm -rf /opt/LigandMPNN/.git

    # LigandMPNN vendors a copy of openfold from the numpy-1 era, and this base
    # ships numpy 2. The vendored code uses np.int, which numpy DEPRECATED in
    # 1.20 and REMOVED in 1.24:
    #
    #   File "openfold/np/residue_constants.py", line 1124
    #     restype_atom37_to_rigid_group = np.zeros([21, 37], dtype=np.int)
    #   AttributeError: module 'numpy' has no attribute 'int'
    #
    # Rewriting them is not a workaround. np.int, np.float, np.bool, np.object,
    # np.str and np.complex were never distinct types -- they were aliases for
    # the Python builtins, which is exactly why numpy removed them, and numpy's
    # own error message says substituting the builtin "will not modify any
    # behavior and is safe". This is the change upstream openfold made too.
    #
    # The word boundary is what keeps it safe: np.int64, np.float32, np.bool_
    # and np.str_ are REAL numpy types and must survive. A digit or underscore
    # after the name is a word character, so \b does not match there. Verified
    # by the grep below, which fails the build rather than trusting the sed.
    find /opt/LigandMPNN -name '*.py' -print0 | xargs -0 sed -i -E \
        -e 's/\bnp\.(int|float|bool|object|str|complex)\b/\1/g' \
        -e 's/\bnumpy\.(int|float|bool|object|str|complex)\b/\1/g' \
        -e 's/\bnp\.NaN\b/np.nan/g' -e 's/\bnp\.Inf\b/np.inf/g'
    if grep -rnE '\b(np|numpy)\.(int|float|bool|object|str|complex)\b' \
            /opt/LigandMPNN --include='*.py'; then
        echo "FATAL: deprecated numpy aliases survived the rewrite" >&2; exit 1
    fi
    # And confirm the real types were NOT collateral damage.
    grep -rq 'np\.int64\|np\.float32' /opt/LigandMPNN --include='*.py' \
        || { echo "FATAL: sed ate the real numpy dtypes" >&2; exit 1; }

    # PEP 668: the pytorch base images ship a conda python marked
    # EXTERNALLY-MANAGED, so a bare `pip install` refuses with
    #   error: externally-managed-environment
    # and apptainer then reports "exit status 1" under a message suggesting
    # --ignore-fakeroot-command, which has nothing to do with it. Inside a
    # container the system interpreter IS the environment -- there is no OS
    # package manager to conflict with and nothing else sharing it -- so
    # overriding the marker is correct here, not a workaround.
    export PIP_BREAK_SYSTEM_PACKAGES=1

    pip install --no-cache-dir ProDy ml-collections dm-tree biopython

    # Weights are NOT in the repo; upstream ships a script that fetches them.
    # Run that rather than hardcoding URLs, so the set stays whatever upstream
    # considers current for this commit. ~1 GB, baked in: they are frozen
    # release artefacts and a compute node has no internet to fetch them from.
    cd /opt/LigandMPNN
    bash get_model_params.sh "/opt/LigandMPNN/model_params"
    # wget -q hides failures and writes a zero-byte file on a 404, so count.
    n=$(ls -1 /opt/LigandMPNN/model_params/*.pt 2>/dev/null | wc -l)
    test "$n" -ge 8 || { echo "FATAL: only $n weight files fetched" >&2; exit 1; }
    for f in /opt/LigandMPNN/model_params/*.pt; do
        test -s "$f" || { echo "FATAL: empty weights $f" >&2; exit 1; }
    done

    chmod -R a+rX /opt/LigandMPNN

    # Import the chain run.py actually opens with, not just the leaf packages.
    # The first build of this image checked prody/ml_collections/tree/Bio/torch
    # here, passed, and then failed in %test -- because what was broken was the
    # vendored openfold underneath sc_utils, which none of those touch. A build
    # check is only worth the minutes it costs if it fails where the recipe is
    # wrong.
    cd /opt/LigandMPNN
    python - <<'PY'
import sys
sys.path.insert(0, "/opt/LigandMPNN")
import prody, ml_collections, tree, Bio, torch, numpy
import openfold.np.residue_constants          # the numpy-alias casualty
from sc_utils import Packer, pack_side_chains  # what run.py imports at line 24
print("prody", prody.__version__, "torch", torch.__version__, "numpy", numpy.__version__)
print("sc_utils and vendored openfold import cleanly")
PY

%environment
    export LC_ALL=C.UTF-8
    export PYTHONNOUSERSITE=1
    export LIGANDMPNN_DIR=/opt/LigandMPNN

%test
    set -eu
    python /opt/LigandMPNN/run.py --help > /dev/null
    test -s /opt/LigandMPNN/model_params/ligandmpnn_v_32_010_25.pt
    echo "built from $(cat /opt/LigandMPNN/.built-from)"

%runscript
    exec "$@"

%help
    LigandMPNN, pinned at 26ec57ac, weights included under
    /opt/LigandMPNN/model_params.

      chpc-tool exec ligandmpnn -- /opt/LigandMPNN/run.py \
          --model_type ligand_mpnn --pdb_path in.pdb --out_folder out/

    Use this rather than plain ProteinMPNN when the substrate or a covalent
    intermediate should be visible to the design -- ProteinMPNN conditions on
    backbone N/CA/C/O only and cannot see a ligand at all.
