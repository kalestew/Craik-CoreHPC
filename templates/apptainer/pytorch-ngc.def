# Layer lab packages on top of an NVIDIA NGC PyTorch image (CUDA + NCCL + PyTorch matched).
# Build on the login node:  apptainer build pytorch_lab_24.01.sif pytorch-ngc.def
Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.01-py3

%post
    pip install --no-cache-dir biopython pandas scikit-learn wandb

%environment
    export PYTHONNOUSERSITE=1

%runscript
    exec "$@"

%labels
    Author Craik Lab
    Base nvcr.io/nvidia/pytorch:24.01-py3
